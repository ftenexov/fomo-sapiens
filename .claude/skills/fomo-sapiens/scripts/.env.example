# ── Fomo Sapiens config ──────────────────────────────────────────────────────
# Copy this file to `.env` (same folder) and fill it in. Never commit `.env`.
#
# 1) TOKENS — log into fomo.family in a browser, open DevTools → Console, run:
#
#    copy(`FOMO_ACCESS_TOKEN=${JSON.parse(localStorage.getItem('privy:token'))}
#    FOMO_REFRESH_TOKEN=${JSON.parse(localStorage.getItem('privy:refresh_token'))}
#    FOMO_PRIVY_ACCESS_TOKEN=${JSON.parse(localStorage.getItem('privy:pat')||'null')}`)
#
#    …then paste the clipboard over the three lines below. (Tokens expire ~hourly;
#    they auto-refresh, but when refresh finally dies, re-paste and run:
#    `python3 fomo.py reseed`.)
FOMO_ACCESS_TOKEN=
FOMO_REFRESH_TOKEN=
FOMO_PRIVY_ACCESS_TOKEN=

# 2) SIGNING KEYS — only needed to EXECUTE trades (reads/quotes/thesis don't need them).
#    Export from fomo/Privy "export wallet". Leave blank if you won't trade that chain.
#    ⚠ These control ALL funds in the wallet. Plaintext on disk — guard this file.
# FOMO_WALLET_KEY: Solana base58 secret key (swap.py — buys & Solana sells)
FOMO_WALLET_KEY=
# FOMO_EVM_KEY: EVM private key, 0x-hex (swap_evm.py — EVM-token sells)
FOMO_EVM_KEY=

# 3) OPTIONAL
# FOMO_PROFILE=alice      # name this account's token cache (multi-account)

# 4) AGENT LEDGER — OPT-IN, off by default. Nothing is reported unless you opt in with
#    `python3 fomo.py ledger on`. When on, trades made through this skill are reported
#    (best-effort, never blocks a trade) to an internal API that tracks PnL and ranks agents;
#    registration is wallet-signature-based — your fomo/Privy token is never sent. Turn it off
#    again any time: `python3 fomo.py ledger off` (deletes your agent + data server-side).
# LEDGER_URL=https://fomo-skill-api.fly.dev   # default; set to blank to point elsewhere / disable
# LEDGER_OPT_IN=1                             # set by `ledger on`; unset/0 = off (the default)
LEDGER_AGENT_KEY=
